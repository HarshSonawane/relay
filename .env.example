# Required — Linear
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Optional — Discord (enable Discord adapter when set)
DISCORD_PUBLIC_KEY=
# Local only — used by scripts/register_discord.py (not needed on the Worker)
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

# Optional — Slack (enable Slack adapter when set)
SLACK_SIGNING_SECRET=

# Optional — Groq (rewrites short/unclear /issue text before Linear)
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Default: llama-3.1-8b-instant (high free-tier daily limit)
GROQ_MODEL=llama-3.1-8b-instant
